{
  "name": "git-ai-summarizer",
  "displayName": "Git AI Summarizer",
  "description": "AI-powered VS Code extension that analyzes Git diffs and generates structured commit summaries, release notes, and architectural insights.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:git-ai-summarizer-sidebar"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "git-ai-summarizer-container",
          "title": "Git AI Summarizer",
          "icon": "$(git-commit)"
        }
      ]
    },
    "views": {
      "git-ai-summarizer-container": [
        {
          "type": "webview",
          "id": "git-ai-summarizer-sidebar",
          "name": "Analyze Commits",
          "icon": "$(git-commit)"
        }
      ]
    },
    "commands": [
      {
        "command": "git-ai-summarizer.setApiKey",
        "title": "Git AI Summarizer: Set API Key"
      },
      {
        "command": "git-ai-summarizer.analyzeDiff",
        "title": "Git AI Summarizer: Analyze Git Diff"
      },
      {
        "command": "git-ai-summarizer.copyMarkdownReport",
        "title": "Copy Markdown Report",
        "category": "Git AI Summarizer"
      },
      {
        "command": "git-ai-summarizer.compareDifferentRange",
        "title": "Compare Different Range",
        "category": "Git AI Summarizer"
      }
    ],
    "configuration": {
      "title": "Git AI Summarizer",
      "properties": {
        "git-ai-summarizer.provider": {
          "type": "string",
          "default": "gemini",
          "enum": [
            "gemini",
            "groq",
            "ollama"
          ],
          "enumDescriptions": [
            "Google Gemini API",
            "Groq API",
            "Local Ollama server"
          ],
          "description": "Select the AI provider used to generate summaries."
        },
        "git-ai-summarizer.model": {
          "type": "string",
          "default": "gemini-2.5-flash",
          "description": "Model name to use with the selected AI provider."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "git-ai-summarizer.copyMarkdownReport",
          "when": "resourceLangId == markdown",
          "group": "navigation@1"
        },
        {
          "command": "git-ai-summarizer.compareDifferentRange",
          "when": "resourceLangId == markdown",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "groq-sdk": "^1.4.1"
  }
}