{
  "name": "git-ai-summarizer",
  "displayName": "Git AI Summarizer",
  "description": "AI-powered VS Code extension that analyzes Git diffs and generates structured commit summaries, release notes, and architectural insights.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "git-ai-summarizer.setApiKey",
        "title": "Git AI Summarizer: Set API Key"
      },
      {
        "command": "git-ai-summarizer.analyzeDiff",
        "title": "Git AI Summarizer: Analyze Git Diff"
      }
    ],
    "configuration": {
      "title": "Git AI Summarizer",
      "properties": {
        "git-ai-summarizer.provider": {
          "type": "string",
          "default": "gemini",
          "enum": [
            "gemini",
            "groq",
            "ollama"
          ],
          "enumDescriptions": [
            "Google Gemini API",
            "Groq API",
            "Local Ollama server"
          ],
          "description": "Select the AI provider used to generate summaries."
        },
        "git-ai-summarizer.model": {
          "type": "string",
          "default": "gemini-2.5-flash",
          "description": "Model name to use with the selected AI provider."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}